# ===================================================
# ZMS LIZZA BACKEND — ENVIRONMENT VARIABLES
# ===================================================

# ── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/zmslizza_admin

# ── JWT Auth ────────────────────────────────────────
JWT_SECRET=zms_lizza_super_secret_key_change_this_in_production_2024
JWT_EXPIRE=7d
