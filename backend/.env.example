NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/zmslizza_db?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

MAX_FILE_UPLOAD=10485760
VIEW_FINGERPRINT_SALT=replace-with-random-salt

# Preferred: comma-separated allowlist for split frontend/backend deployments.
CORS_ORIGINS=https://zmslizzafrontend.vercel.app,https://zmslizzaadmin.vercel.app

# Backward compatible fallback when CORS_ORIGINS is not provided.
CLIENT_URL=https://zmslizzafrontend.vercel.app

# API URL used in email unsubscribe links and other generated links.
API_BASE_URL=https://zms-lizza-backend.onrender.com/api/v1

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cloudinary (required for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email automation (Resend + queue)
# In production, EMAIL_DELIVERY_ENABLED defaults to true.
# In development, EMAIL_DELIVERY_ENABLED defaults to false.
EMAIL_DELIVERY_ENABLED=true
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=LIZZA INDIA PRIVATE LIMITED <noreply@yourdomain.com>
EMAIL_REPLY_TO_DEFAULT=support@yourdomain.com
EMAIL_STAFF_TO=sales@yourcompany.com

# Email queue tuning (optional)
EMAIL_QUEUE_POLL_MS=3000
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_QUEUE_LOCK_TIMEOUT_MS=90000
EMAIL_QUEUE_MAX_ATTEMPTS=5
EMAIL_QUEUE_BASE_DELAY_SECONDS=30
EMAIL_QUEUE_MAX_DELAY_SECONDS=1800

# Optional seed credentials (recommended to set explicitly before running npm run seed)
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=replace-with-strong-password
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-strong-password
SEED_EDITOR_EMAIL=editor@example.com
SEED_EDITOR_PASSWORD=replace-with-strong-password
SEED_INACTIVE_EDITOR_EMAIL=inactive-editor@example.com
SEED_INACTIVE_EDITOR_PASSWORD=replace-with-strong-password

# Optional one-time production password rotation targets
ROTATE_SUPERADMIN_EMAIL=
ROTATE_SUPERADMIN_PASSWORD=
ROTATE_ADMIN_EMAIL=
ROTATE_ADMIN_PASSWORD=
ROTATE_EDITOR_EMAIL=
ROTATE_EDITOR_PASSWORD=
