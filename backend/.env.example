NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/zms-lizza

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

MAX_FILE_UPLOAD=10485760
VIEW_FINGERPRINT_SALT=replace-with-random-salt

# Preferred: comma-separated allowlist for split frontend/backend deployments.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Backward compatible fallback when CORS_ORIGINS is not provided.
CLIENT_URL=http://localhost:5173

# Cloudinary (required for media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
